# Copy this file to .env.local in this same directory and fill in your own values.
# Next.js loads .env.local automatically for the dev server, and the ingestion,
# evaluation and verification scripts load it through lib/load-env.ts.
#
# `.env.local` is matched by the `.env*` rule in this directory's .gitignore, so it
# is never committed. Never commit a real key, and never paste one into client code:
# only server modules read GEMINI_API_KEY.

# --- Required: embeddings for ingestion, search and evaluation ---
# A Google AI Studio key for the Generative Language API:
#   https://aistudio.google.com/apikey
# It is used for one job: embedding the corpus and each search query. Answers are
# generated locally by Ollama (see below), so generation never uses this key.
GEMINI_API_KEY=

# --- Optional overrides ---

# Embedding provider: "gemini" (default) or "test-hash".
# "test-hash" is a deterministic, semantics-free test double. It exists so the
# ingestion and retrieval plumbing can be exercised without credentials. It must
# never be used for evaluation, and the evaluation script refuses to run with it
# unless --allow-test-embeddings is passed.
# EMBEDDING_PROVIDER=gemini

# Embedding model. The previous default, text-embedding-004, was shut down on
# 14 January 2026, so it can no longer be used. gemini-embedding-001 is the current
# text embedding model and accepts the retrieval task types this project relies on.
# Changing this, or EMBEDDING_DIM, makes every stored vector incomparable and
# requires re-ingestion.
# EMBEDDING_MODEL=gemini-embedding-001

# Output vector dimension. The model defaults to 3072; 768 is the recommended
# trade-off between retrieval quality and storage. Changing it requires re-ingestion.
# EMBEDDING_DIM=768

# --- Generation: a local model served by Ollama ---

# Where the Ollama API listens. The server calls this address, not the browser, so
# "localhost" is the machine running the website backend. For a deployment, point
# this at an Ollama host the backend can reach. Do not expose Ollama's port to the
# public internet without network restrictions.
# OLLAMA_BASE_URL=http://localhost:11434

# The pulled model tag. Install it with `ollama pull llama3.2:3b`.
# OLLAMA_MODEL=llama3.2:3b

# Whole-request deadline in milliseconds, covering model load and generation. A 3B
# model on a busy machine can take tens of seconds for a cited answer.
# OLLAMA_TIMEOUT_MS=120000

# Maximum generated tokens, and the context window reserved for the prompt plus
# the answer. The prompt is a system instruction and at most six passages.
# OLLAMA_MAX_TOKENS=1024
# OLLAMA_NUM_CTX=8192

# How long the model stays loaded between questions. Keeps the first answer of a
# session from paying the load cost again.
# OLLAMA_KEEP_ALIVE=10m

# Minimum cosine similarity for a retrieved passage to be usable as evidence.
# Values below this cause an explicit abstention rather than an answer.
# RETRIEVAL_MIN_COSINE=0.5

# Number of embedding inputs sent per request during ingestion.
# EMBEDDING_BATCH_SIZE=8

# Where the SQLite database and evaluation report live. Defaults to ./data
# HEALTH_DATA_DIR=
# HEALTH_DB_PATH=

# --- Optional: answer from retrieved passages without a language model ---

# When set to 1, the assistant makes no generation call at all: every question that
# retrieval can support is answered by quoting the relevant source passages, with the
# document and publisher beside each quotation, and the interface labels the answer as
# quoted passages rather than a written answer. Retrieval still needs the embedding key
# for the query vector. Useful when Ollama is deliberately not run, and when the
# extractive fallback needs to be exercised deliberately.
# ASSISTANT_RETRIEVAL_ONLY=1

# --- Peer community moderation ---

# Comma-separated account emails allowed to review community reports. There is no
# self-service moderator role, and an unset value means nobody can moderate.
# COMMUNITY_MODERATOR_EMAILS=moderator@example.org
